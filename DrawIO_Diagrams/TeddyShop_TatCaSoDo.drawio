        <mxCell id="m8" value="8. Redirect /order-success/&lt;code&gt;/ (Hiện mã đơn &amp; thiệp)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0284C7;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry x="385" y="430" as="geometry"><mxPoint x="385" y="430" as="sourcePoint"/><mxPoint x="135" y="430" as="targetPoint"/></mxGeometry>
        </mxCell>
    
      </root>
    </mxGraphModel>
