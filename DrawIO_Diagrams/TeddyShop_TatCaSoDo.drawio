        <mxCell id="sm3" value="3. Trả về thông tin bé gấu (giá, ảnh, tên)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry x="645" y="190" as="geometry"><mxPoint x="645" y="190" as="sourcePoint"/><mxPoint x="405" y="190" as="targetPoint"/></mxGeometry></mxCell>
