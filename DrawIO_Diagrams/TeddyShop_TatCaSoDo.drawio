        <mxCell id="sm1" value="1. POST /cart/add/&lt;id&gt;/ (size='80cm', quantity=1)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#8B5A2B;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry x="140" y="100" as="geometry"><mxPoint x="140" y="100" as="sourcePoint"/><mxPoint x="405" y="100" as="targetPoint"/></mxGeometry></mxCell>
