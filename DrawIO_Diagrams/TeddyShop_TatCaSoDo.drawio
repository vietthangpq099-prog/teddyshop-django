        <mxCell id="ll_db" value="&lt;b&gt;SQL Server DB&lt;/b&gt;&lt;br&gt;(Orders &amp; Details)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="40" width="140" height="460" as="geometry" />
        </mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="1. POST /cart/checkout/ (Họ tên, SĐT, Địa chỉ, Thiệp chúc)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#0284C7;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry x="135" y="110" as="geometry"><mxPoint x="135" y="110" as="sourcePoint"/><mxPoint x="385" y="110" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. Lấy giỏ hàng session.get('cart')" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#D97706;strokeWidth=1.5;" edge="1" parent="1">
