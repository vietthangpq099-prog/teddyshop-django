        </mxCell>
        <mxCell id="m3" value="3. Trả về dict các món gấu bông &amp; tổng tiền" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry x="640" y="190" as="geometry"><mxPoint x="640" y="190" as="sourcePoint"/><mxPoint x="385" y="190" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. Order.objects.create(OrderCode, GiftMessage, Status='Chờ xác nhận')" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry x="385" y="240" as="geometry"><mxPoint x="385" y="240" as="sourcePoint"/><mxPoint x="890" y="240" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. OrderDetail.objects.create(từng bé gấu, size, đơn giá)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#16A34A;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry x="385" y="290" as="geometry"><mxPoint x="385" y="290" as="sourcePoint"/><mxPoint x="890" y="290" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. Lưu CSDL thành công" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1">
