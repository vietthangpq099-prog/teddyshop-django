        <mxCell id="sm5" value="5. Session updated &amp; request.session.modified = True" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;strokeColor=#059669;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry x="870" y="280" as="geometry"><mxPoint x="870" y="280" as="sourcePoint"/><mxPoint x="405" y="280" as="targetPoint"/></mxGeometry></mxCell>
