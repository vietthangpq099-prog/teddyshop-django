        </mxCell>
        <mxCell id="m7" value="7. del request.session['cart'] (Làm sạch giỏ hàng)" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#D97706;strokeWidth=1.5;" edge="1" parent="1">
